# AgentCore Harness Configuration
AGENTCORE_HARNESS_ARN=arn:aws:bedrock-agentcore:us-east-1:your-account-id:harness/your-harness-id
AWS_REGION=us-east-1

# App Authentication (leave empty for no password)
APP_PASSWORD=

# Don't put AWS keys in this file. Paste them into aws-credentials.txt and run
# `python setup_aws.py`.
